# Copiar a .env y completar. El .env NUNCA se versiona.
# Para el backend dentro de Docker Compose no hace falta: docker-compose.yml ya
# define estas variables. Este archivo sirve para ejecutar el backend fuera de
# Docker contra la base del Compose (puerto 5433).
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-de-al-menos-32-caracteres
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 16 del Compose de desarrollo
DATABASE_URL=postgres://logistica:desarrollo@localhost:5433/logistica_minera_dev

# Pruebas sobre PostgreSQL (opcional; sin ella, SQLite en memoria)
# TEST_DATABASE_URL=postgres://logistica:desarrollo@localhost:5433/logistica_minera_test

# Angular en desarrollo
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Imagenes del ticket: almacenamiento de archivos de Django (D-14 provisional, D-18)
MEDIA_ROOT=media

# Sesion JWT (M01)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Patrón de placa vehicular (D-24, RNF-M05-08)
# PATRON_PLACA=^[A-Z0-9]{3}-[A-Z0-9]{3}$
