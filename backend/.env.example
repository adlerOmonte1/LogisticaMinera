# Copiar a .env y completar. El .env NUNCA se versiona.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambiar-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 16
DATABASE_URL=postgres://logistica:cambiar@localhost:5432/logistica_minera_dev

# Angular en desarrollo
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Sesión JWT (M01)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
