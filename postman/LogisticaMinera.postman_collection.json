{
  "info": {
    "_postman_id": "bab490db-b4a8-4e27-b77f-b5ef5d1f09ba",
    "name": "LogisticaMinera API v1",
    "description": "Colección del sistema web inteligente para el control de inventarios de ingreso de mineral. Una carpeta por fase de PLAN-02 (docs/01-plan/PLAN_IMPLEMENTACION.md). Ejecute siempre «00 · Sesiones» antes de cualquier otra carpeta. Los criterios de aceptación de cada fase están en el Anexo A de PLAN-02.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Umbral de tiempo de respuesta (PLAN-02 §4.4). El reconocimiento usa limite_ms = 5000.",
          "pm.test(\"Responde dentro del umbral\", () => {",
          "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get(\"limite_ms\") || 2000));",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 · Sesiones",
      "description": "Inicia sesión con las tres cuentas de prueba y guarda sus tokens. Requiere haber ejecutado `python manage.py cargar_datos_prueba`.",
      "item": [
        {
          "name": "Sesión · ADMINISTRADOR -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario_admin}}\",\n  \"password\": \"{{clave_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Inicia sesión con la cuenta de prueba del rol y guarda sus tokens en el entorno."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Entrega access y refresh\", () => {",
                  "  pm.expect(b.access).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(b.refresh).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Rol ADMINISTRADOR\", () => pm.expect(b.usuario.rol).to.eql(\"ADMINISTRADOR\"));",
                  "pm.environment.set(\"token_admin\", b.access);",
                  "pm.environment.set(\"refresh_admin\", b.refresh);"
                ]
              }
            }
          ]
        },
        {
