    {
      "name": "F0 · Salud y esquema",
      "description": "Puerta de F0: el backend arranca con la línea base 2.1, publica su esquema y ya no expone las rutas del diseño anterior.",
      "item": [
        {
          "name": "F0 · Esquema OpenAPI -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/esquema/?format=json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Documento OpenAPI 3\", () => pm.expect(String(b.openapi)).to.match(/^3\\./));",
                  "pm.test(\"Título de la línea base 2.1\", () => pm.expect(b.info.title).to.include(\"ingreso de mineral\"));",
                  "pm.test(\"Publica la ruta de tipos de mineral\", () => pm.expect(Object.keys(b.paths)).to.include(\"/api/v1/catalogo/tipos-mineral/\"));",
                  "pm.test(\"No publica rutas de productos\", () => pm.expect(Object.keys(b.paths).join(\" \")).to.not.include(\"productos\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "F0 · Documentación de la API -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/docs/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Interfaz de documentación\", () => pm.expect(pm.response.text().toLowerCase()).to.include(\"swagger\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "F0 · Tipos de mineral con sesión -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_supervisor}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/catalogo/tipos-mineral/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Listado paginado\", () => {",
                  "  pm.expect(b).to.have.property(\"count\");",
                  "  pm.expect(b.results).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "F0 · Tipos de mineral sin sesión -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/catalogo/tipos-mineral/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Cuerpo uniforme (D-23)\", () => {",
                  "  pm.expect(pm.response.json()).to.have.all.keys(\"codigo\", \"mensaje\", \"detalles\");",
                  "});",
                  "pm.test(\"Código NO_AUTENTICADO\", () => pm.expect(pm.response.json().codigo).to.eql(\"NO_AUTENTICADO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "F0 · Ruta anterior de productos -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_supervisor}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/catalogo/productos/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404: la ruta del diseño anterior ya no existe\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "F0 · Registro de ingresos aún sin rutas -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_supervisor}}",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/ingresos/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404: el registro del diseño anterior se retiró; M03 se publica en F3\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
